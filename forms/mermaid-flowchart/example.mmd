flowchart TD
    %% id: read-path
    subgraph user[user space]
        read["read()"]
    end
    read --> ksys[ksys_read]
    ksys --> vfs[vfs_read]
    vfs --> hit{"page cache hit?"}
    hit -- yes --> copy[copy_to_user]
    hit -- no --> bio[submit_bio]
    bio --> irq[completion IRQ]:::muted
    irq --> copy
    bio -- error --> eio["-EIO"]:::danger
    copy --> done[return bytes]:::accent
